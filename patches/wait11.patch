new file mode 100644
index 0000000..eb2534b
--- /dev/null
+++ packages/opencode/src/tool/wait.ts
@@ -0,0 +1,240 @@
+import { Effect, Schema } from "effect"
+import net from "node:net"
+import fs from "node:fs/promises"
+import * as Tool from "./tool"
+import DESCRIPTION from "./wait.txt"
+
+const PROBE_TIMEOUT_MS = 5_000
+const DEFAULT_INTERVAL_MS = 5_000
+const DEFAULT_TIMEOUT_MS = 60 * 60 * 1000
+
+const Condition = Schema.Union([
+  Schema.Struct({
+    kind: Schema.Literal("port"),
+    port: Schema.Number.annotate({ description: "TCP port that must start accepting connections" }),
+    host: Schema.optional(Schema.String).annotate({ description: "Host to connect to. Defaults to 127.0.0.1" }),
+  }),
+  Schema.Struct({
+    kind: Schema.Literal("http"),
+    url: Schema.String.annotate({ description: "URL that must respond" }),
+    status: Schema.optional(Schema.Number).annotate({ description: "Status that must come back. Defaults to 200" }),
+  }),
+  Schema.Struct({
+    kind: Schema.Literal("file"),
+    path: Schema.String.annotate({ description: "Path that must exist" }),
+    contains: Schema.optional(Schema.String).annotate({ description: "Text the file must contain" }),
+  }),
+  Schema.Struct({
+    kind: Schema.Literal("process"),
+    pid: Schema.Number.annotate({ description: "PID that must have exited" }),
+  }),
+])
+
+export const Parameters = Schema.Struct({
+  until: Condition.annotate({ description: "The condition to wait for" }),
+  timeoutMs: Schema.optional(
+    Schema.Number.annotate({
+      description: `Give up after this long. Defaults to ${DEFAULT_TIMEOUT_MS}ms. Nothing is killed on timeout`,
+    }),
+  ),
+  intervalMs: Schema.optional(
+    Schema.Number.annotate({ description: `How often to re-check. Defaults to ${DEFAULT_INTERVAL_MS}ms` }),
+  ),
+})
+
+type Metadata = {
+  until: string
+  satisfied: boolean
+  elapsedMs: number
+  timedOut: boolean
+  aborted: boolean
+  polls: number
+}
+
+/**
+ * Every probe answers one question — "is it ready yet?" — so a failure to even
+ * ask is a "no", never a defect. Each one swallows its own errors and returns
+ * `false`, which keeps a closed port, a 500 or a missing file from killing the
+ * turn and keeps the error channel of `check` empty.
+ */
+const probePort = (host: string, port: number) =>
+  Effect.promise(
+    () =>
+      new Promise<boolean>((resolve) => {
+        const socket = net.connect({ host, port })
+        const settle = (value: boolean) => {
+          socket.removeAllListeners()
+          socket.destroy()
+          resolve(value)
+        }
+        socket.setTimeout(PROBE_TIMEOUT_MS, () => settle(false))
+        socket.once("connect", () => settle(true))
+        socket.once("error", () => settle(false))
+      }),
+  )
+
+const probeHttp = (url: string, status: number) =>
+  Effect.promise(async () => {
+    try {
+      const response = await fetch(url, { signal: AbortSignal.timeout(PROBE_TIMEOUT_MS) })
+      return response.status === status
+    } catch {
+      return false
+    }
+  })
+
+const probeFile = (path: string, contains: string | undefined) =>
+  Effect.promise(async () => {
+    try {
+      if (contains === undefined) {
+        await fs.stat(path)
+        return true
+      }
+      const text = await fs.readFile(path, "utf8")
+      return text.includes(contains)
+    } catch {
+      return false
+    }
+  })
+
+/**
+ * Inverted on purpose: a backgrounded job is "done" when it is gone. Signal 0
+ * performs the existence check without touching the process, and anything other
+ * than ESRCH (EPERM, say) means it is still there, so we keep waiting.
+ */
+const probeProcess = (pid: number) =>
+  Effect.sync(() => {
+    try {
+      process.kill(pid, 0)
+      return false
+    } catch (error) {
+      return (error as NodeJS.ErrnoException)?.code === "ESRCH"
+    }
+  })
+
+const describe = (until: Schema.Schema.Type<typeof Condition>) => {
+  switch (until.kind) {
+    case "port":
+      return `${until.host ?? "127.0.0.1"}:${until.port} accepting connections`
+    case "http":
+      return `${until.url} returning ${until.status ?? 200}`
+    case "file":
+      return `${until.path} existing${until.contains ? ` and containing ${JSON.stringify(until.contains)}` : ""}`
+    case "process":
+      return `process ${until.pid} having exited`
+  }
+}
+
+const check = (until: Schema.Schema.Type<typeof Condition>): Effect.Effect<boolean> => {
+  switch (until.kind) {
+    case "port":
+      return probePort(until.host ?? "127.0.0.1", until.port)
+    case "http":
+      return probeHttp(until.url, until.status ?? 200)
+    case "file":
+      return probeFile(until.path, until.contains)
+    case "process":
+      return probeProcess(until.pid)
+  }
+}
+
+export const WaitTool = Tool.define<typeof Parameters, Metadata, never>(
+  "wait",
+  Effect.succeed({
+    description: DESCRIPTION,
+    parameters: Parameters,
+    execute: (
+      params: Schema.Schema.Type<typeof Parameters>,
+      ctx: Tool.Context<Metadata>,
+    ): Effect.Effect<Tool.ExecuteResult<Metadata>> =>
+      Effect.gen(function* () {
+        yield* ctx.ask({
+          permission: "wait",
+          patterns: ["*"],
+          always: ["*"],
+          metadata: {},
+        })
+
+        const until = params.until
+        const subject = describe(until)
+        const intervalMs = params.intervalMs ?? DEFAULT_INTERVAL_MS
+        const timeoutMs = params.timeoutMs ?? DEFAULT_TIMEOUT_MS
+        const start = Date.now()
+
+        // Publish progress every poll. A wait that looks identical to a hang is
+        // the failure mode this whole feature exists to avoid, so the running
+        // clock is part of the tool's output rather than something the user has
+        // to guess at.
+        const report = (satisfied: boolean, polls: number) =>
+          ctx.metadata({
+            metadata: {
+              until: subject,
+              satisfied,
+              elapsedMs: Date.now() - start,
+              timedOut: false,
+              aborted: false,
+              polls,
+            },
+          })
+
+        const poll = Effect.gen(function* () {
+          let polls = 0
+          while (true) {
+            polls++
+            if (yield* check(until)) return { kind: "satisfied" as const, polls }
+            const remaining = timeoutMs - (Date.now() - start)
+            if (remaining <= 0) return { kind: "timedout" as const, polls }
+            yield* report(false, polls)
+            yield* Effect.sleep(`${Math.min(intervalMs, remaining)} millis`)
+          }
+        })
+
+        const abort = Effect.callback<void>((resume) => {
+          if (ctx.abort.aborted) return resume(Effect.void)
+          const handler = () => resume(Effect.void)
+          ctx.abort.addEventListener("abort", handler, { once: true })
+          return Effect.sync(() => ctx.abort.removeEventListener("abort", handler))
+        })
+
+        // Abort only ends the waiting. There is no child process here to spare,
+        // so unlike `bash` there is nothing to leave running and nothing to
+        // clean up.
+        const outcome = yield* Effect.raceAll([
+          poll.pipe(Effect.map((result) => ({ ...result, aborted: false as const }))),
+          abort.pipe(Effect.map(() => ({ kind: "abort" as const, polls: 0, aborted: true as const }))),
+        ])
+
+        const elapsedMs = Date.now() - start
+        const satisfied = outcome.kind === "satisfied"
+        const metadata: Metadata = {
+          until: subject,
+          satisfied,
+          elapsedMs,
+          timedOut: outcome.kind === "timedout",
+          aborted: outcome.aborted,
+          polls: outcome.polls,
+        }
+
+        let title: string
+        let output: string
+        if (satisfied) {
+          title = `waited ${(elapsedMs / 1000).toFixed(1)}s`
+          output = `Condition satisfied after ${(elapsedMs / 1000).toFixed(1)}s (${outcome.polls} checks): ${subject}`
+        } else if (metadata.aborted) {
+          title = "wait aborted"
+          output = `Wait was aborted by the user after ${(elapsedMs / 1000).toFixed(1)}s, before the condition held: ${subject}`
+        } else {
+          title = "wait timed out"
+          // Nothing was killed — there is nothing of ours to kill — so say so
+          // plainly. The condition simply never became true within the budget.
+          output = [
+            `Condition did not become true within ${(elapsedMs / 1000).toFixed(1)}s (${outcome.polls} checks): ${subject}`,
+            ``,
+            `Nothing was started or killed by this wait. If the condition is still expected to hold, call wait again with a larger timeoutMs.`,
+          ].join("\n")
+        }
+
+        return { title, output, metadata }
+      }),
+  }),
+)
