index 0000000..be700d2
--- /dev/null
+++ b/packages/opencode/src/auth/wire-identity.ts
@@ -0,0 +1,22 @@
+import { createHash } from "crypto"
+const LENGTH = 26
+const CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+function keyId(key: string){return createHash("sha256").update(key).digest("hex")}
+function mintIdentifier(prefix: string, seed: string){
+  const digest = createHash("sha512").update(seed).digest()
+  let hex=""
+  for (let index=0;index<6;index++) hex+=digest[index]!.toString(16).padStart(2,"0")
+  let tail=""
+  for (let index=0;index<LENGTH-12;index++) tail+=CHARS[digest[6+index]!%62]
+  return `${prefix}_${hex}${tail}`
+}
+function mintProject(seed: string){return createHash("sha1").update(seed).digest("hex")}
+export type WireInput={readonly sessionID:string,readonly messageID:string,readonly projectID?:string,readonly parentSessionID?:string,readonly key:string|undefined}
+export function identity(input:WireInput){
+  const key=input.key
+  if(!key){return {session:input.sessionID,message:input.messageID,project:input.projectID,parent:input.parentSessionID}}
+  const salt=`\u0000${keyId(key)}`
+  return {session:mintIdentifier("ses",`${input.sessionID}${salt}`),message:mintIdentifier("msg",`${input.messageID}${salt}`),project:input.projectID?mintProject(`${input.projectID}${salt}`):undefined,parent:input.parentSessionID?mintIdentifier("ses",`${input.parentSessionID}${salt}`):undefined}
+}
+export function release(_sessionID:string){}
+export * as AuthWireIdentity from "./wire-identity"
