+import { afterEach, expect } from "bun:test"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { CrossSpawnSpawner } from "@opencode-ai/core/cross-spawn-spawner"
+import { Effect } from "effect"
+import { ProviderV2 } from "@opencode-ai/core/provider"
+import { ModelV2 } from "@opencode-ai/core/model"
+import { disposeAllInstances, provideTmpdirInstance } from "../fixture/fixture"
+import { testEffect } from "../lib/effect"
+import { testProviderConfig } from "../lib/test-provider"
+import { Env } from "@/env"
+import { Plugin } from "@/plugin"
+import { Provider } from "@/provider/provider"
+import { Auth } from "@/auth"
+import * as AuthPool from "@/auth/pool"
+
+// Regression cover for "switching the API key did nothing".
+//
+// The provider state is an instance-scoped cache, so a credential resolved once
+// used to stay in force for the whole process. Every key switch therefore
+// returned HTTP 200 while the old key kept being sent, which presented as
+// "quota is still exhausted no matter which key I pick".
+
+afterEach(async () => {
+  await disposeAllInstances()
+})
+
+const it = testEffect(
+  LayerNode.compile(LayerNode.group([Provider.node, Env.node, Plugin.node, CrossSpawnSpawner.node, Auth.node])),
+)
+
+it.live("getLanguage returns a distinct client per API key instead of reusing the first one", () =>
+  Effect.gen(function* () {
+    yield* provideTmpdirInstance(
+      () =>
+        Effect.gen(function* () {
+          const provider = yield* Provider.Service
+          const model = yield* provider.getModel(ProviderV2.ID.make("test"), ModelV2.ID.make("test-model"))
+
+          const first = yield* provider.getLanguage(model, "key-one")
+          const firstAgain = yield* provider.getLanguage(model, "key-one")
+          const second = yield* provider.getLanguage(model, "key-two")
+
+          // Stable for the same key, distinct for a different one.
+          expect(firstAgain).toBe(first)
+          expect(second).not.toBe(first)
+
+          // The default path must also be unaffected.
+          const fallback = yield* provider.getLanguage(model)
+          expect(fallback).toBeDefined()
+        }),
+      { config: testProviderConfig("http://127.0.0.1:1/v1") },
+    )
+  }),
+)
+
+it.live("Auth.all prefers the on-disk store over OPENCODE_AUTH_CONTENT", () =>
+  Effect.gen(function* () {
+    yield* provideTmpdirInstance(
+      () =>
+        Effect.gen(function* () {
+          const auth = yield* Auth.Service
+          const previous = process.env.OPENCODE_AUTH_CONTENT
+          process.env.OPENCODE_AUTH_CONTENT = JSON.stringify({ test: { type: "api", key: "seeded-key" } })
+          try {
+            // A key written after the seed was set must win immediately.
+            yield* auth.set("test", { type: "api", key: "written-key" })
+            const current = yield* auth.get("test")
+            expect(current?.type).toBe("api")
+            expect(current?.type === "api" ? current.key : undefined).toBe("written-key")
+          } finally {
+            if (previous === undefined) delete process.env.OPENCODE_AUTH_CONTENT
+            else process.env.OPENCODE_AUTH_CONTENT = previous
+          }
+        }),
+      { config: testProviderConfig("http://127.0.0.1:1/v1") },
+    )
+  }),
+)
+
+// Regression cover for key selection across a set of accounts.
+//
+// The set is the key in auth.json plus every entry in auth-pool.json, and no
+// member is privileged: the auth.json key is merely first, so the very first
+// request of the very first session uses it. A session keeps the key it was given
+// for as long as that key stays healthy, and only gives it up when that key is rate
+// limited.
+
+const poolIt = testEffect(
+  LayerNode.compile(
+    LayerNode.group([Provider.node, Env.node, Plugin.node, CrossSpawnSpawner.node, Auth.node, AuthPool.node]),
+  ),
+)
+
+// The lease table lives for the lifetime of the service, so each test uses its own
+// provider id: sharing one would let an earlier test's leases decide a later
+// test's key.
+const withThreeKeys = (
+  providerID: string,
+  fn: (pool: AuthPool.Interface, auth: Auth.Interface) => Effect.Effect<unknown, Auth.AuthError>,
+) =>
+  provideTmpdirInstance(
+    () =>
+      Effect.gen(function* () {
+        const auth = yield* Auth.Service
+        const pool = yield* AuthPool.Service
+        yield* auth.set(providerID, { type: "api", key: "sk-auth-json" })
+        yield* pool.add(providerID, { key: "sk-pool-1", label: "one" })
+        yield* pool.add(providerID, { key: "sk-pool-2", label: "two" })
+        return yield* fn(pool, auth)
+      }),
+    { config: testProviderConfig("http://127.0.0.1:1/v1") },
+  )
+
+poolIt.live("the first session is given the auth.json key and later sessions get idle keys", () =>
+  withThreeKeys("p-first", (pool) =>
+    Effect.gen(function* () {
+      const first = yield* pool.select("p-first", { sessionID: "ses-1" })
+      expect(first.key).toBe("sk-auth-json")
+      expect(first.reason).toBe("idle")
+
+      const second = yield* pool.select("p-first", { sessionID: "ses-2" })
+      expect(second.key).toBe("sk-pool-1")
+      expect(second.reason).toBe("idle")
+
+      const third = yield* pool.select("p-first", { sessionID: "ses-3" })
+      expect(third.key).toBe("sk-pool-2")
+    }),
+  ),
+)
+
+poolIt.live("a session keeps its key instead of being moved to an idle one", () =>
+  withThreeKeys("p-hold", (pool) =>
+    Effect.gen(function* () {
+      yield* pool.select("p-hold", { sessionID: "ses-1" })
+      const again = yield* pool.select("p-hold", { sessionID: "ses-1" })
+      expect(again.key).toBe("sk-auth-json")
+      expect(again.reason).toBe("held")
+    }),
+  ),
+)
+
+poolIt.live("deleting a session releases its key for the next session", () =>
+  withThreeKeys("p-release", (pool) =>
+    Effect.gen(function* () {
+      yield* pool.select("p-release", { sessionID: "ses-1" })
+      expect((yield* pool.select("p-release", { sessionID: "ses-2" })).key).toBe("sk-pool-1")
+      yield* pool.releaseSession("ses-1")
+      expect((yield* pool.select("p-release", { sessionID: "ses-3" })).key).toBe("sk-auth-json")
+    }),
+  ),
+)
+
+poolIt.live("a cooled down key is skipped, including the one in auth.json", () =>
+  withThreeKeys("p-cool", (pool) =>
+    Effect.gen(function* () {
+      yield* pool.cooldown("p-cool", "sk-auth-json", 60_000)
+      const picked = yield* pool.select("p-cool", { sessionID: "ses-1" })
+      expect(picked.key).not.toBe("sk-auth-json")
+      expect(picked.key).toBe("sk-pool-1")
+    }),
+  ),
+)
+
+poolIt.live("selecting never rewrites auth.json", () =>
+  withThreeKeys("p-nowrite", (pool, auth) =>
+    Effect.gen(function* () {
+      yield* pool.select("p-nowrite", { sessionID: "ses-1" })
+      yield* pool.cooldown("p-nowrite", "sk-auth-json", 60_000)
+      yield* pool.select("p-nowrite", { sessionID: "ses-2" })
+      yield* pool.select("p-nowrite", { sessionID: "ses-3" })
+      const current = yield* auth.get("p-nowrite")
+      expect(current?.type === "api" ? current.key : undefined).toBe("sk-auth-json")
+    }),
+  ),
+)
+
+poolIt.live("when every key is cooling down the earliest recovery is reported", () =>
+  withThreeKeys("p-allcool", (pool) =>
+    Effect.gen(function* () {
+      yield* pool.cooldown("p-allcool", "sk-auth-json", 90_000)
+      yield* pool.cooldown("p-allcool", "sk-pool-1", 30_000)
+      yield* pool.cooldown("p-allcool", "sk-pool-2", 60_000)
+      const picked = yield* pool.select("p-allcool", { sessionID: "ses-1" })
+      expect(picked.reason).toBe("cooling")
+      expect(picked.key).toBe("sk-pool-1")
+      expect(picked.waitMs).toBeGreaterThan(0)
+      expect(picked.waitMs!).toBeLessThanOrEqual(30_000)
+    }),
+  ),
+)
+
+poolIt.live("a rotation moves only the failing session, leaving other sessions alone", () =>
+  withThreeKeys("p-rotate", (pool) =>
+    Effect.gen(function* () {
+      const held = yield* pool.select("p-rotate", { sessionID: "ses-1" })
+      expect(held.key).toBe("sk-auth-json")
+      yield* pool.select("p-rotate", { sessionID: "ses-2" })
+
+      yield* pool.cooldown("p-rotate", "sk-auth-json", 60_000)
+      const rotated = yield* pool.select("p-rotate", { sessionID: "ses-1", exclude: ["sk-auth-json"] })
+      expect(rotated.key).toBe("sk-pool-2")
+      expect(rotated.reason).toBe("idle")
+
+      // ses-2 still holds sk-pool-1 and is untouched by ses-1's rotation.
+      expect((yield* pool.select("p-rotate", { sessionID: "ses-2" })).key).toBe("sk-pool-1")
+    }),
+  ),
+)
