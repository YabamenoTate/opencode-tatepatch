diff --git a/packages/opencode/test/provider/header-identity.test.ts b/packages/opencode/test/provider/header-identity.test.ts
new file mode 100644
index 0000000..d0013ca
--- /dev/null
+++ b/packages/opencode/test/provider/header-identity.test.ts
@@ -0,0 +1,76 @@
+// Proves the header contract, which is the part that is easy to get wrong by
+// accident: the set of field names must equal upstream's, and the identifying
+// values must be stable per key but different across keys.
+import { expect, test } from "bun:test"
+import { readFileSync } from "fs"
+import { join } from "path"
+import { createHash } from "crypto"
+
+// The literal field names upstream v1.18.31 sends in session/llm/request.ts, read
+// off that file rather than off our own, so the guard stays meaningful after this
+// patch lands. `x-opencode-project` is the one this patch changes the value of; the
+// contract is that the field is still there.
+const UPSTREAM_HEADER_FIELDS = [
+  "User-Agent",
+  "X-Session-Id",
+  "x-opencode-client",
+  "x-opencode-project",
+  "x-opencode-request",
+  "x-opencode-session",
+  "x-parent-session-id",
+  "x-session-affinity",
+]
+
+const CURRENT = join(import.meta.dir, "..", "..", "src", "session", "llm", "request.ts")
+
+// Pull the literal header names out of the headers object, so the comparison is
+// against the source text rather than against a restatement of it.
+function headerNames(source: string): string[] {
+  const start = source.indexOf("headers: {")
+  if (start === -1) throw new Error("no headers object found")
+  const body = source.slice(start, source.indexOf("\n    },\n  }", start))
+  return [...body.matchAll(/"([A-Za-z0-9-]+)":/g)].map((m) => m[1]!)
+}
+
+test("the header field names are exactly the ones upstream sends", () => {
+  const current = [...new Set(headerNames(readFileSync(CURRENT, "utf8")))].toSorted()
+  expect(current).toEqual([...UPSTREAM_HEADER_FIELDS].toSorted())
+})
+
+// The same derivation the client uses, so this checks the property rather than a
+// hard-coded expectation.
+const keyScoped = (value: string, key: string | undefined): string => {
+  if (!key) return value
+  return createHash("sha256").update(`${value}\u0000${key}`).digest("hex").slice(0, 32)
+}
+
+test("an identity is stable while the session stays on one key", () => {
+  expect(keyScoped("ses_1", "key-A")).toBe(keyScoped("ses_1", "key-A"))
+})
+
+test("rotating to another key presents a fingerprint that key has never seen", () => {
+  expect(keyScoped("ses_1", "key-B")).not.toBe(keyScoped("ses_1", "key-A"))
+})
+
+test("the project identity is preserved per key rather than removed", () => {
+  // Same key, same project: stable, so a gateway can still cache per account.
+  expect(keyScoped("git-remote:proj", "key-A")).toBe(keyScoped("git-remote:proj", "key-A"))
+  // Different key, same checkout: a different project identity, so the two
+  // accounts are not known to be the same machine.
+  expect(keyScoped("git-remote:proj", "key-B")).not.toBe(keyScoped("git-remote:proj", "key-A"))
+})
+
+test("two different projects on one key stay distinguishable", () => {
+  expect(keyScoped("git-remote:projA", "key-A")).not.toBe(keyScoped("git-remote:projB", "key-A"))
+})
+
+test("the derived value does not contain the key or the seed", () => {
+  const derived = keyScoped("git-remote:proj", "sk-secret-value")
+  expect(derived).not.toContain("sk-secret-value")
+  expect(derived).not.toContain("git-remote")
+  expect(derived).toMatch(/^[0-9a-f]{32}$/)
+})
+
+test("a request without an API key is passed through unchanged", () => {
+  expect(keyScoped("ses_1", undefined)).toBe("ses_1")
+})
