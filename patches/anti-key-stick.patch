index 0000000..e849aee
--- /dev/null
+++ b/packages/opencode/src/auth/wire-identity.ts
@@ -0,0 +1,54 @@
+import { createHash } from "crypto"
+
+const LENGTH = 26
+const CHARS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+
+function keyId(key: string) {
+  return createHash("sha256").update(key).digest("hex")
+}
+
+function mintIdentifier(prefix: string, seed: string) {
+  const digest = createHash("sha512").update(seed).digest()
+  let hex = ""
+  for (let index = 0; index < 6; index++) hex += digest[index]!.toString(16).padStart(2, "0")
+  let tail = ""
+  for (let index = 0; index < LENGTH - 12; index++) tail += CHARS[digest[6 + index]! % 62]
+  return `${prefix}_${hex}${tail}`
+}
+
+function mintProject(seed: string) {
+  return createHash("sha1").update(seed).digest("hex")
+}
+
+export type WireInput = {
+  readonly sessionID: string
+  readonly messageID: string
+  readonly projectID?: string
+  readonly parentSessionID?: string
+  readonly key: string | undefined
+}
+
+export function identity(input: WireInput) {
+  const key = input.key
+  if (!key) {
+    return {
+      session: input.sessionID,
+      message: input.messageID,
+      project: input.projectID,
+      parent: input.parentSessionID,
+    }
+  }
+  const salt = `\u0000${keyId(key)}`
+  return {
+    session: mintIdentifier("ses", `${input.sessionID}${salt}`),
+    message: mintIdentifier("msg", `${input.messageID}${salt}`),
+    project: input.projectID ? mintProject(`${input.projectID}${salt}`) : undefined,
+    parent: input.parentSessionID ? mintIdentifier("ses", `${input.parentSessionID}${salt}`) : undefined,
+  }
+}
+
+export function release(_sessionID: string) {
+  // Identity is deterministic from (sessionID, key); no in-memory bindings to release.
+}
+
+export * as AuthWireIdentity from "./wire-identity"
diff --git a/packages/opencode/test/provider/header-identity.test.ts b/packages/opencode/test/provider/header-identity.test.ts
new file mode 100644
index 0000000..c131826
--- /dev/null
+++ b/packages/opencode/test/provider/header-identity.test.ts
@@ -0,0 +1,56 @@
+import { describe, expect, test } from "bun:test"
+import * as AuthWireIdentity from "../../src/auth/wire-identity"
+
+const SESSION = "ses_test0123456789abcdefghijkl"
+const MESSAGE = "msg_test0123456789abcdefghijkl"
+const PROJECT = "project-test-123"
+
+const wire = (key?: string) =>
+  AuthWireIdentity.identity({ sessionID: SESSION, messageID: MESSAGE, projectID: PROJECT, key })
+
+describe("auth wire identity", () => {
+  test("a session that stays on one key sends deterministic key-scoped values", () => {
+    const out = wire("key-A")
+    expect(out.session).toMatch(/^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+    expect(out.message).toMatch(/^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+    expect(out.project).toMatch(/^[0-9a-f]{40}$/)
+    expect(out.session).not.toBe(SESSION)
+  })
+
+  test("switching the api key mints new identities and keeps them different per key", () => {
+    const a = wire("key-A")
+    const b = wire("key-B")
+    const c = wire("key-B")
+
+    expect(a.session).not.toBe(b.session)
+    expect(a.message).not.toBe(b.message)
+    expect(a.project).not.toBe(b.project)
+    expect(b).toEqual(c)
+  })
+
+  test("no key passes identities through unchanged", () => {
+    const out = wire(undefined)
+    expect(out.session).toBe(SESSION)
+    expect(out.message).toBe(MESSAGE)
+    expect(out.project).toBe(PROJECT)
+    expect(out.parent).toBeUndefined()
+  })
+
+  test("the parent identity follows the same key scoping as the session", () => {
+    const parent = "ses_parent0123456789abcdefghi"
+    const out = (key?: string) =>
+      AuthWireIdentity.identity({ sessionID: SESSION, messageID: MESSAGE, parentSessionID: parent, key })
+    expect(out(undefined).parent).toBe(parent)
+    expect(out("key-A").parent).not.toBe(parent)
+    expect(out("key-B").parent).not.toBe(parent)
+    expect(out("key-B").parent).toMatch(/^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+  })
+
+  test("releasing a session is a no-op with deterministic identities", () => {
+    const first = AuthWireIdentity.identity({ sessionID: "ses_release", messageID: MESSAGE, key: "key-A" })
+    AuthWireIdentity.release("ses_release")
+    expect(
+      AuthWireIdentity.identity({ sessionID: "ses_release", messageID: MESSAGE, key: "key-A" }),
+    ).toEqual(first)
+  })
+})
