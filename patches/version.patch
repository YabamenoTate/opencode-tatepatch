+const TATEPATCH_VERSION = "v1.18.31 (Tate Patched 4)"
+const TATEPATCH_REPO = "YabamenoTate/opencode-tatepatch"
+
+function tatepatchDir(): string | null {
+  const home =
+    process.env.OPENCODE_CONFIG_DIR ||
+    (process.platform === "win32"
+      ? (process.env.USERPROFILE || "") + "/.config/opencode"
+      : (process.env.HOME || "") + "/.config/opencode")
+  if (!home) return null
+  const dir = home + "/tatepatch"
+  if (!existsSync(dir)) return null
+  return dir
+}
+
+async function fetchLatestRelease(): Promise<{ name: string; tag_name: string } | null> {
+  const res = await fetch(`https://api.github.com/repos/${TATEPATCH_REPO}/releases/latest`, {
+    headers: { "User-Agent": "opencode" },
+  })
+  if (!res.ok) return null
+  return res.json()
+}
+
+async function listRemoteFiles(tag: string, subpath: string): Promise<string[]> {
+  const url = `https://api.github.com/repos/${TATEPATCH_REPO}/contents/${subpath}?ref=${tag}`
+  const res = await fetch(url, { headers: { "User-Agent": "opencode" } })
+  if (!res.ok) return []
+  const items: any[] = await res.json()
+  return items.map((i) => i.name)
+}
+
+function listLocalPatches(dir: string): string[] {
+  try {
+    return readdirSync(dir + "/patches").filter((f: string) => f.endsWith(".patch"))
+  } catch {
+    return []
+  }
+}
+
+function getExcluded(remote: string[], local: string[]): string[] {
+  return remote.filter((p) => !local.includes(p))
+}
+
+function backupFile(tpDir: string): string {
+  return tpDir + (process.platform === "win32" ? "/opencode-official-backup.exe" : "/opencode-official-backup")
+}
 
 export async function upgrade() {
