+
+  const latestTitle: string = release.name
+  const tagName: string = release.tag_name
+
+  if (TATEPATCH_VERSION === latestTitle) return
+
+  console.log(`\n==> TatePatch update available: ${latestTitle}`)
+
+  const remotePatches = await listRemoteFiles(tagName, "patches")
+  const localPatches = listLocalPatches(tpDir)
+  const excluded = getExcluded(remotePatches, localPatches)
+
+  const bf = backupFile(tpDir)
