+  const code = await new Promise<number | null>((resolve) => {
+    const child = spawn(
+      isWin ? "cmd.exe" : "bash",
+      isWin ? ["/c", script, "unapply"] : [script, "unapply"],
+      { cwd: tpDir, stdio: "inherit" },
+    )
+    child.on("exit", (c) => resolve(c))
+  })
+
+  if (code !== 0) {
+    console.error("FAILED: unapply failed")
     return
   }
 
-  if (method === "unknown") return
-  await Installation.upgrade(method, latest)
