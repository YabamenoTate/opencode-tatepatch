index 25d9cd9..b58ce52 100644
--- a/packages/core/src/installation/version.ts
+++ b/packages/core/src/installation/version.ts
@@ -6,3 +6,32 @@ declare global {
 export const InstallationVersion = typeof OPENCODE_VERSION === "string" ? OPENCODE_VERSION : "local"
 export const InstallationChannel = typeof OPENCODE_CHANNEL === "string" ? OPENCODE_CHANNEL : "local"
 export const InstallationLocal = InstallationChannel === "local"
+export const InstallationClientVersion = InstallationVersion.replace(/^v/, "")
+  .replace(/\s*\(.*\).*/, "")
+  .replace(/[^0-9.].*$/, "")
+
+// tatepatch versioning. The two values below are the only hardcoded version
+// numbers left in the tree, and they are placeholders: patch.sh / patch.bat
+// substitute them from the repository's VERSION file before building, so the
+// level lives in exactly one place. Everything else — the CLI --version output,
+// the web app banner, and the update check in cli/upgrade.ts — reads the derived
+// constants rather than repeating the string.
+export const TATEPATCH_BASE_VERSION = "1.19.4"
+export const TATEPATCH_PATCH_LEVEL = "5"
+
+// "<base> (Tate Patched <level>)" — the suffix appended to an existing version
+// string.
+export const TATEPATCH_LABEL = "(Tate Patched " + TATEPATCH_PATCH_LEVEL + ")"
+
+// "v<base> (Tate Patched <level>)" — the form the CLI prints, matching what a
+// stock `opencode --version` looks like.
+export const TATEPATCH_VERSION = "v" + TATEPATCH_BASE_VERSION + " " + TATEPATCH_LABEL
+
+// "<base> (Tate Patched <level>)" — the same string without the leading "v", for
+// surfaces that never showed one, such as the web app's version banner.
+export const TATEPATCH_PLAIN_VERSION = TATEPATCH_BASE_VERSION + " " + TATEPATCH_LABEL
+
+// InstallationClientVersion (defined above) is the version we identify ourselves
+// with to external services (User-Agent): a clean semver even when
+// InstallationVersion carries a display suffix such as TATEPATCH_LABEL, so
+// version gates like the zen free tier accept the build.
