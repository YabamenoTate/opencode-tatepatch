+    renameSync(bf, tmpPath)
+  }
+
+  rmSync(tpDir, { recursive: true, force: true })
+
+  const cloneUrl = `https://github.com/${TATEPATCH_REPO}.git`
+  try {
+    execSync(`git clone --depth 1 --branch "${tagName}" "${cloneUrl}" "${tpDir}"`, { stdio: "inherit" })
