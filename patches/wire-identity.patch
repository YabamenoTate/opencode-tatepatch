+import { describe, expect, beforeEach } from "bun:test"
+import fs from "node:fs"
+import path from "node:path"
+import { Effect } from "effect"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { Global } from "@opencode-ai/core/global"
+import { testEffect } from "../lib/effect"
+import * as AuthPool from "../../src/auth/pool"
+
+const poolFile = path.join(Global.Path.data, "auth-pool.json")
+const it = testEffect(LayerNode.compile(LayerNode.group([FSUtil.node, AuthPool.node])))
+
+function seed(data: unknown) {
+  fs.writeFileSync(poolFile, JSON.stringify(data), { mode: 0o600 })
+}
+
+function read() {
+  return JSON.parse(fs.readFileSync(poolFile, "utf8"))
+}
+
+describe("auth.pool.rotate", () => {
+  beforeEach(() => {
+    fs.rmSync(poolFile, { force: true })
+  })
+
+  it.instance("switches to a usable key and records the failed key's cooldown", () =>
+    Effect.gen(function* () {
+      seed({
+        test: [{ key: "sk-aaa", label: "A" }, { key: "sk-bbb", label: "B" }],
+      })
+      const pool = yield* AuthPool.Service
+      const res = yield* pool.rotate("test", 5_000, "sk-aaa")
+      expect(res.switched).toBe(true)
+      expect(res.exhausted).toBe(false)
+      expect(res.key).toBe("sk-bbb")
+      expect(res.label).toBe("B")
+
+      const saved = read()
+      const ra = saved._retryAfter["test"]
+      expect(Object.keys(ra)).toHaveLength(1)
+      expect(ra[AuthPool.sha256("sk-aaa")]).toBeGreaterThan(Date.now())
+    }),
+  )
+
+  it.instance("returns the earliest recovery when every pooled key is cooling down", () =>
+    Effect.gen(function* () {
+      seed({
+        test: [{ key: "sk-aaa", label: "A" }, { key: "sk-bbb", label: "B" }],
+        _retryAfter: { test: { [AuthPool.sha256("sk-aaa")]: Date.now() + 600_000 } },
+      })
+      const pool = yield* AuthPool.Service
+      const res = yield* pool.rotate("test", 700_000, "sk-bbb")
+      expect(res.switched).toBe(false)
+      expect(res.exhausted).toBe(false)
+      expect(res.key).toBe("sk-aaa")
+      expect(res.waitMs).toBeDefined()
+      expect(res.waitMs!).toBeGreaterThan(0)
+      expect(res.waitMs!).toBeLessThanOrEqual(700_000)
+    }),
+  )
+
+  it.instance("returns nothing usable when the pool is empty", () =>
+    Effect.gen(function* () {
+      seed({})
+      const pool = yield* AuthPool.Service
+      const res = yield* pool.rotate("test", 60_000, "sk-main")
+      expect(res).toEqual({ switched: false, exhausted: false })
+    }),
+  )
+
+  it.instance("a manual switch clears recorded cooldowns", () =>
+    Effect.gen(function* () {
+      seed({
+        test: [{ key: "sk-aaa", label: "A" }, { key: "sk-bbb", label: "B" }],
+        _retryAfter: { test: { [AuthPool.sha256("sk-bbb")]: Date.now() + 600_000 } },
+      })
+      const pool = yield* AuthPool.Service
+      const res = yield* pool.switchByKey("test", AuthPool.sha256("sk-aaa"), "sk-bbb")
+      expect(res.found).toBe(true)
+      expect(res.key).toBe("sk-aaa")
+      const saved = read()
+      expect(saved._retryAfter).toBeUndefined()
+    }),
+  )
+})
