+describe("tool.shell idle backgrounding", () => {
+  const idle = RuntimeFlags.layer({ bashIdleTimeoutMs: 1500 })
+
+  const alive = (pid: number) =>
+    Effect.sync(() => {
+      if (process.platform === "win32") {
+        const out = Bun.spawnSync(["tasklist", "/FI", `PID eq ${pid}`, "/NH"]).stdout.toString()
+        return out.includes(String(pid))
+      }
+      try {
+        process.kill(pid, 0)
+        return true
+      } catch {
+        return false
+      }
+    })
+
+  const reap = (pid: number) =>
+    Effect.sync(() => {
+      if (process.platform === "win32") Bun.spawnSync(["taskkill", "/PID", String(pid), "/T", "/F"])
+      else {
+        try {
+          process.kill(-pid, "SIGKILL")
+        } catch {
+          try {
+            process.kill(pid, "SIGKILL")
+          } catch {}
+        }
+      }
+    })
+
+  it.live(
+    "moves a silent long-running command to the background instead of waiting for it",
+    () =>
+      runIn(
+        projectRoot,
+        Effect.gen(function* () {
+          const started = Date.now()
+          const result = yield* run({ command: `sleep 60` })
+          const elapsed = Date.now() - started
+
+          // The whole point: the turn is not held open for the command.
+          expect(elapsed).toBeLessThan(30_000)
+          expect(result.output).toContain("moved to the BACKGROUND")
+          expect(result.output).toContain("wait about 10 seconds")
+          expect(result.metadata.exit).toBeNull()
+          expect((result.metadata as { backgrounded?: boolean }).backgrounded).toBe(true)
+
+          const pid = (result.metadata as { backgroundPid?: number }).backgroundPid
+          expect(typeof pid).toBe("number")
+
+          // Scope teardown runs as soon as the tool call returns. If it killed the
+          // process the "background" promise would be a lie.
+          expect(yield* alive(pid!)).toBe(true)
+          yield* reap(pid!)
+        }),
+      ).pipe(Effect.provide(idle)),
+    60_000,
+  )
+
+  it.live(
+    "reports the background pid and its log file in the tool result",
+    () =>
+      runIn(
+        projectRoot,
+        Effect.gen(function* () {
+          const result = yield* run({ command: `sleep 60` })
+          const pid = (result.metadata as { backgroundPid?: number }).backgroundPid
+          expect(result.output).toContain(`PID ${pid}`)
+          expect(result.output).toContain("Stop-Process -Id")
+          yield* reap(pid!)
+        }),
+      ).pipe(Effect.provide(idle)),
+    60_000,
+  )
+
+  it.live(
+    "never suspends a command that keeps producing output",
+    () =>
+      runIn(
+        projectRoot,
+        Effect.gen(function* () {
+          const code = `for (let i = 0; i < 10; i++) { console.log("tick" + i); await new Promise((r) => setTimeout(r, 400)) }`
+          const text = `${bin} -e ${evalarg(code)}`
+          const result = yield* run({ command: PS.has(sh()) ? `& ${text}` : text })
+
+          expect(result.metadata.exit).toBe(0)
+          expect(result.output).toContain("tick0")
+          expect(result.output).toContain("tick9")
+          expect(result.output).not.toContain("moved to the BACKGROUND")
+          expect((result.metadata as { backgrounded?: boolean }).backgrounded).toBeUndefined()
+        }),
+      ).pipe(Effect.provide(idle)),
+    30_000,
+  )
+
+  it.live(
+    "backgrounds a silent command instead of killing it when no timeout is requested",
+    () =>
+      runIn(
+        projectRoot,
+        Effect.gen(function* () {
+          // Regression: the tool used to impose a 2 minute wall-clock default. That
+          // default fired *before* the idle window, so a silent command was killed and
+          // never reached the background path at all - the feature was inert.
+          const flags = RuntimeFlags.layer({ bashDefaultTimeoutMs: undefined, bashIdleTimeoutMs: 1_500 })
+          const result = yield* run({ command: `sleep 60` }).pipe(Effect.provide(flags))
+          const md = result.metadata as { backgrounded?: boolean; backgroundPid?: number }
+          const pid = md.backgroundPid
+          try {
+            expect(result.output).toContain("moved to the BACKGROUND")
+            expect(result.output).not.toContain("exceeding timeout")
+            expect(md.backgrounded).toBe(true)
+            expect(typeof pid).toBe("number")
+            expect(yield* alive(pid!)).toBe(true)
+          } finally {
+            if (pid) yield* reap(pid)
+          }
+        }),
+      ).pipe(Effect.provide(idle)),
+    60_000,
+  )
+
+  it.live(
+    "backgrounds a server even when a huge timeout was requested",
+    () =>
+      runIn(
+        projectRoot,
+        Effect.gen(function* () {
+          // This is the real-world path: the model starts a dev server and asks for a
+          // multi-hour timeout, so the shell used to sit there indefinitely. A huge
+          // timeout must not buy the turn back - the idle window still ends the wait.
