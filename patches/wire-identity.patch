+        const tool = yield* initShell()
+        expect(tool.description).toContain("Long-lived processes")
+        expect(tool.description).toContain("NEVER wait for them to exit")
+        expect(tool.description).toContain("wait about 10 seconds")
+        expect(tool.description).toContain("no upper limit on")
+        expect(tool.description).toContain("no time limit at all")
+        expect(tool.description).not.toContain("capped at")
+        expect(tool.description).not.toContain("time out after 120000ms")
+      }),
+    ),
+  )
+
+  it.live("honours a requested timeout far beyond any former ceiling", () =>
+    runIn(
+      projectRoot,
+      Effect.gen(function* () {
+        // A build may legitimately be asked for hours. Nothing may clamp it, or the
