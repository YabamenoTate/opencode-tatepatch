diff --git a/packages/opencode/src/auth/pool.ts b/packages/opencode/src/auth/pool.ts
new file mode 100644
index 0000000..31c84d0
--- /dev/null
+++ b/packages/opencode/src/auth/pool.ts
@@ -0,0 +1,458 @@
+import path from "path"
+import crypto from "crypto"
+import { Effect, Layer, Schema, Context } from "effect"
+import { Global } from "@opencode-ai/core/global"
+import { FSUtil } from "@opencode-ai/core/fs-util"
+import { LayerNode } from "@opencode-ai/core/effect/layer-node"
+import { Auth } from "@/auth"
+
+const POOL_FILE = path.join(Global.Path.data, "auth-pool.json")
+
+// A lease is a claim that some session is currently using a key. Leases live in
+// memory only: they describe who is busy right now, which the pool file cannot
+// know. Cooldowns, by contrast, must outlive a restart, so they stay on disk.
+const LEASE_TTL_MS = 15 * 60_000
+
+export class PoolSchema extends Schema.Class<PoolSchema>("AuthPoolEntry")({
+  key: Schema.String,
+  label: Schema.optional(Schema.String),
+}) {}
+
+export type PoolEntry = Schema.Schema.Type<typeof PoolSchema>
+
+type PoolData = Record<string, unknown>
+
+export interface RotateResult {
+  switched: boolean
+  label?: string
+  exhausted: boolean
+  key?: string
+  // When every key is cooling down: ms until the earliest recovery.
+  waitMs?: number
+}
+
+export type SelectReason = "held" | "idle" | "lru" | "cooling" | "none"
+
+export interface SelectOptions {
+  sessionID?: string
+  exclude?: string[]
+}
+
+export interface SelectResult {
+  key?: string
+  label?: string
+  reason: SelectReason
+  // Present only when `reason` is "cooling": ms until the earliest key recovers.
+  waitMs?: number
+}
+
+export interface PublicLease {
+  key_hash: string
+  key_masked: string
+  label?: string
+  since: number
+}
+
+export interface Interface {
+  readonly list: (providerID: string) => Effect.Effect<PublicPoolEntry[], never>
+  readonly add: (providerID: string, entry: PoolEntry) => Effect.Effect<void, never>
+  readonly removeByKey: (providerID: string, keyHash: string) => Effect.Effect<boolean, never>
+  readonly switchByKey: (providerID: string, keyHash: string, currentKey?: string) => Effect.Effect<{ found: boolean; key?: string }, never>
+  readonly count: (providerID: string) => Effect.Effect<number, never>
+  readonly resetToMain: (providerID: string) => Effect.Effect<string | undefined, never>
+  readonly rotate: (providerID: string, retryAfterMs?: number, currentKey?: string) => Effect.Effect<RotateResult, never>
+  readonly select: (providerID: string, opts?: SelectOptions) => Effect.Effect<SelectResult, never>
+  readonly cooldown: (providerID: string, key: string, retryAfterMs: number) => Effect.Effect<void, never>
+  readonly touch: (providerID: string, key: string, sessionID: string) => Effect.Effect<void, never>
+  readonly releaseSession: (sessionID: string) => Effect.Effect<void, never>
+  readonly leases: (providerID: string) => Effect.Effect<PublicLease[], never>
+}
+
+export class Service extends Context.Service<Service, Interface>()("@opencode/AuthPool") {}
+
+export function sha256(key: string): string {
+  return crypto.createHash("sha256").update(key).digest("hex")
+}
+
+export interface PublicPoolEntry {
+  key_hash: string
+  key_masked: string
+  label?: string
+}
+
+function maskKey(key: string): string {
+  if (key.length <= 12) return key.slice(0, 4) + "..."
+  return key.slice(0, 8) + "..." + key.slice(-4)
+}
+
+function getEntries(data: PoolData, providerID: string): PoolEntry[] {
+  return Array.isArray(data[providerID]) ? (data[providerID] as PoolEntry[]) : []
+}
+
+function getMain(data: PoolData, providerID: string): string | undefined {
+  const main = data._main as Record<string, string> | undefined
+  return main?.[providerID]
+}
+
+const rawPool = (fsys: FSUtil.Interface) =>
+  fsys.readJson(POOL_FILE).pipe(
+    Effect.map((data) => data as PoolData),
+    Effect.orElseSucceed(() => ({}) as PoolData),
+  )
+
+const writePool = (fsys: FSUtil.Interface, data: PoolData) =>
+  fsys.writeJson(POOL_FILE, data, 0o600).pipe(Effect.orDie)
+
+interface Lease {
+  sessionID: string
+  lastUsed: number
+  keyHash: string
+  keyMasked: string
+  label?: string
+}
+
+export const layer = Layer.effect(
+  Service,
+  Effect.gen(function* () {
+    const fsys = yield* FSUtil.Service
+    const auth = yield* Auth.Service
+
+    // providerID -> keyHash -> lease
+    const leaseTable = new Map<string, Map<string, Lease>>()
+
+    // The key in auth.json is not privileged. It is kept in its own file purely so
+    // upstream opencode (which reads a single key) keeps working, and it joins the
+    // rotation set as one member among equals, ordered first so that the very first
+    // request of the very first session uses it.
+    const authKey = Effect.fn("AuthPool.authKey")(function* (providerID: string) {
+      const info = yield* auth.get(providerID).pipe(Effect.orElseSucceed(() => undefined))
+      return info?.type === "api" ? info.key : undefined
+    })
+
+    const candidates = (data: PoolData, providerID: string, mainKey?: string): PoolEntry[] => {
+      const out: PoolEntry[] = []
+      if (mainKey) out.push({ key: mainKey, label: "auth.json" })
+      for (const entry of getEntries(data, providerID)) {
+        if (entry.key !== mainKey) out.push(entry)
+      }
+      return out
+    }
+
+    const pruneLeases = (providerID: string, now: number) => {
+      const table = leaseTable.get(providerID)
+      if (!table) return
+      for (const [hash, lease] of table) {
+        if (now - lease.lastUsed > LEASE_TTL_MS) table.delete(hash)
+      }
+      if (table.size === 0) leaseTable.delete(providerID)
+    }
+
+    // Reads the cooldown table for a provider, dropping entries that already
+    // recovered. Cooldowns are tracked for every known key, including the one in
+    // auth.json, which is why this cannot simply intersect the pool entries.
+    const readCooldowns = (data: PoolData, providerID: string, now: number, known: PoolEntry[]) => {
+      const before = JSON.stringify(data._retryAfter ?? null) + "|" + JSON.stringify(data._tried ?? null)
+      const raData = { ...((data._retryAfter ?? {}) as Record<string, Record<string, number>>) }
+      const ra = { ...(raData[providerID] ?? {}) }
+      const knownHashes = new Set(known.map((e) => sha256(e.key)))
+      for (const hash of Object.keys(ra)) {
+        if (!knownHashes.has(hash) || ra[hash] <= now) {
+          delete ra[hash]
+        }
+      }
+      if (Object.keys(ra).length > 0) {
+        raData[providerID] = ra
+      } else {
+        delete raData[providerID]
+      }
+      if (Object.keys(raData).length === 0) {
+        delete data._retryAfter
+      } else {
+        data._retryAfter = raData
+      }
+      delete data._tried
+      const after = JSON.stringify(data._retryAfter ?? null) + "|" + JSON.stringify(data._tried ?? null)
+      return { ra, changed: before !== after }
+    }
+
+    const list = Effect.fn("AuthPool.list")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      return getEntries(data, providerID).map((e) => ({
+        key_hash: sha256(e.key),
+        key_masked: maskKey(e.key),
+        label: e.label,
+      }))
+    })
+
+    const add = Effect.fn("AuthPool.add")(function* (providerID: string, entry: PoolEntry) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      if (!arr.some((e) => e.key === entry.key)) arr.push(entry)
+      data[providerID] = arr
+      if (data._tried) {
+        delete (data._tried as Record<string, string[]>)[providerID]
+      }
+      const raData = (data._retryAfter ?? {}) as Record<string, Record<string, number>>
+      if (raData[providerID]) {
+        const ra = { ...raData[providerID] }
+        delete ra[sha256(entry.key)]
+        if (Object.keys(ra).length === 0) delete raData[providerID]
+        else raData[providerID] = ra
+      }
+      if (Object.keys(raData).length === 0) delete data._retryAfter
+      else data._retryAfter = raData
+      yield* writePool(fsys, data)
+    })
+
+    const removeByKey = Effect.fn("AuthPool.removeByKey")(function* (providerID: string, keyHash: string) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      const idx = arr.findIndex((e) => sha256(e.key) === keyHash)
+      if (idx < 0) return false
+      arr.splice(idx, 1)
+      if (arr.length === 0) {
+        delete data[providerID]
+      } else {
+        data[providerID] = arr
+      }
+      yield* writePool(fsys, data)
+      leaseTable.get(providerID)?.delete(keyHash)
+      return true
+    })
+
+    const switchByKey = Effect.fn("AuthPool.switchByKey")(function* (
+      providerID: string,
+      keyHash: string,
+      currentKey?: string,
+    ) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      const idx = arr.findIndex((e) => sha256(e.key) === keyHash)
+      if (idx < 0) return { found: false, key: undefined as string | undefined }
+
+      const newKey = arr[idx].key
+
+      if (currentKey && !getMain(data, providerID)) {
+        const main = (data._main as Record<string, string> ?? {})
+        main[providerID] = currentKey
+        data._main = main
+      }
+
+      // Properly swap the accounts: the selected key leaves the pool and becomes
+      // the main account, while the current main key joins the pool. This keeps
+      // both accounts present in the pool file so neither is ever lost.
+      if (currentKey && currentKey !== newKey) {
+        arr.splice(idx, 1)
+        arr.push({ key: currentKey })
+        if (arr.length === 0) {
+          delete data[providerID]
+        } else {
+          data[providerID] = arr
+        }
+      }
+
+      // A manual switch starts a fresh rotation window: clear any cooldowns so
+      // the selected key is usable immediately and not skipped by auto-rotation.
+      if (data._tried) {
+        delete (data._tried as Record<string, string[]>)[providerID]
+        if (Object.keys(data._tried as Record<string, string[]>).length === 0) delete data._tried
+      }
+      if (data._retryAfter) {
+        delete (data._retryAfter as Record<string, Record<string, number>>)[providerID]
+        if (Object.keys(data._retryAfter as Record<string, unknown>).length === 0) delete data._retryAfter
+      }
+
+      yield* writePool(fsys, data)
+      return { found: true, key: newKey }
+    })
+
+    const count = Effect.fn("AuthPool.count")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      return getEntries(data, providerID).length
+    })
+
+    const resetToMain = Effect.fn("AuthPool.resetToMain")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      const mainKey = getMain(data, providerID)
+      if (!mainKey) return undefined
+
+      const arr = getEntries(data, providerID)
+
+      // Remove the restored main key from the pool so it is not duplicated
+      // as both the main account and a pool entry after a reset.
+      const idx = arr.findIndex((e) => e.key === mainKey)
+      if (idx >= 0) {
+        arr.splice(idx, 1)
+      }
+      if (arr.length === 0) {
+        delete data[providerID]
+      } else {
+        data[providerID] = arr
+      }
+
