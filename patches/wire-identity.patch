diff --git a/packages/opencode/test/provider/header-identity.test.ts b/packages/opencode/test/provider/header-identity.test.ts
new file mode 100644
index 0000000..dd5a70b
--- /dev/null
+++ b/packages/opencode/test/provider/header-identity.test.ts
@@ -0,0 +1,121 @@
+// Proves the header contract, which is the part that is easy to get wrong by
+// accident: the set of field names must equal upstream's, and a session that
+// stays on one key must put upstream's own values on the wire, byte for byte.
+import { expect, test } from "bun:test"
+import { readFileSync } from "fs"
+import { join } from "path"
+import { AuthWireIdentity } from "../../src/auth/wire-identity"
+
+// The literal field names upstream sends in session/llm/request.ts, transcribed
+// at the base version named in the tatepatch VERSION file. Re-read this list when
+// the base version moves.
+const UPSTREAM_HEADER_FIELDS = [
+  "User-Agent",
+  "X-Session-Id",
+  "x-opencode-client",
+  "x-opencode-parent-session-id",
+  "x-opencode-project",
+  "x-opencode-request",
+  "x-opencode-session",
+  "x-opencode-session-id",
+  "x-parent-session-id",
+  "x-session-affinity",
+]
+
+const CURRENT = join(import.meta.dir, "..", "..", "src", "session", "llm", "request.ts")
+
+// Pull the literal header names out of the headers object, so the comparison is
+// against the source text rather than against a restatement of it.
+function headerNames(source: string): string[] {
+  const start = source.indexOf("headers: {")
+  if (start === -1) throw new Error("no headers object found")
+  const body = source.slice(start, source.indexOf("\n    },\n  }", start))
+  return [...body.matchAll(/"([A-Za-z0-9-]+)":/g)].map((m) => m[1]!)
+}
+
+test("the header field names are exactly the ones upstream sends", () => {
+  const current = [...new Set(headerNames(readFileSync(CURRENT, "utf8")))].toSorted()
+  expect(current).toEqual([...UPSTREAM_HEADER_FIELDS].toSorted())
+})
+
+const SESSION = "ses_0123456789abcdefghijklmn"
+const MESSAGE = "msg_0123456789abcdefghijklmn"
+const PROJECT = "783c65d89f614968990f66a33764ba28df48704a"
+
+const wire = (key?: string) =>
+  AuthWireIdentity.identity({
+    sessionID: SESSION,
+    messageID: MESSAGE,
+    projectID: PROJECT,
+    key,
+  })
+
+test("a session that stays on one key sends upstream's own values", () => {
+  const out = wire("key-A")
+  expect(out.session).toBe(SESSION)
+  expect(out.message).toBe(MESSAGE)
+  expect(out.project).toBe(PROJECT)
+})
+
+test("a request with no API key is passed through unchanged", () => {
+  const out = wire(undefined)
+  expect(out.session).toBe(SESSION)
+  expect(out.message).toBe(MESSAGE)
+  expect(out.project).toBe(PROJECT)
+})
+
+test("a rotated key sends none of the strings the previous key was shown", () => {
+  const first = wire("key-A")
+  const second = wire("key-B")
+  expect(second.session).not.toBe(first.session)
+  expect(second.message).not.toBe(first.message)
+  expect(second.project).not.toBe(first.project)
+})
+
+test("a minted value keeps upstream's own format", () => {
+  const out = wire("key-B")
+  // Upstream identifiers are <prefix>_<26 chars>: 12 hex then 14 base62.
+  expect(out.session).toMatch(/^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+  expect(out.message).toMatch(/^msg_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+  // Upstream project ids are 40 hex characters.
+  expect(out.project).toMatch(/^[0-9a-f]{40}$/)
+})
+
+test("a minted value does not contain the seed", () => {
+  const out = wire("key-B")
+  expect(out.project).not.toContain("git-remote")
+  expect(out.session).not.toContain(SESSION)
+})
+
+test("an identity is stable while a key stays in use, so a gateway can cache it", () => {
+  expect(wire("key-A")).toEqual(wire("key-A"))
+})
+
+test("a key that comes back presents the identity it had before", () => {
+  const before = wire("key-A")
+  wire("key-B")
+  expect(wire("key-A")).toEqual(before)
+})
+
+test("two sessions on one key stay distinguishable", () => {
+  const other = AuthWireIdentity.identity({ sessionID: "ses_other", messageID: MESSAGE, key: "key-C" })
+  expect(other.session).not.toBe(wire("key-C").session)
+})
+
+test("the parent identity follows the same rotation as the session", () => {
+  const parent = "ses_parent0123456789abcdefghi"
+  const out = (key?: string) =>
+    AuthWireIdentity.identity({ sessionID: SESSION, messageID: MESSAGE, parentSessionID: parent, key })
+  expect(out("key-A").parent).toBe(parent)
+  expect(out("key-B").parent).not.toBe(parent)
+  expect(out("key-B").parent).toMatch(/^ses_[0-9a-f]{12}[0-9A-Za-z]{14}$/)
+})
+
+test("releasing a session drops its identities", () => {
+  AuthWireIdentity.identity({ sessionID: "ses_release", messageID: MESSAGE, key: "key-A" })
+  AuthWireIdentity.release("ses_release")
+  // Back to epoch 0: the fresh session presents upstream's own values again.
+  expect(
+    AuthWireIdentity.identity({ sessionID: "ses_release", messageID: MESSAGE, key: "key-A" }).message,
+  ).toBe(MESSAGE)
+})
