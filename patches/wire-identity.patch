+      })
+      expect(result.metadata.satisfied).toBe(false)
+      expect(result.metadata.timedOut).toBe(true)
+    }),
+  )
+
+  itWait("resolves once a process it did not start has exited", () =>
+    Effect.gen(function* () {
+      const child = Bun.spawn({
+        cmd: [process.execPath, "-e", "setTimeout(() => {}, 500)"],
+        stdout: "ignore",
+        stderr: "ignore",
+      })
+      const result = yield* run({
+        until: { kind: "process", pid: child.pid },
+        intervalMs: 30,
+        timeoutMs: 20_000,
+      })
+      expect(result.metadata.satisfied).toBe(true)
+    }),
+  )
+
+  itWait("keeps waiting while the process is still alive", () =>
+    Effect.gen(function* () {
+      const child = Bun.spawn({
+        cmd: [process.execPath, "-e", "setTimeout(() => {}, 10000)"],
+        stdout: "ignore",
+        stderr: "ignore",
+      })
+      try {
+        const result = yield* run({
+          until: { kind: "process", pid: child.pid },
+          intervalMs: 20,
+          timeoutMs: 250,
+        })
+        expect(result.metadata.satisfied).toBe(false)
+        expect(result.metadata.timedOut).toBe(true)
+      } finally {
+        child.kill()
+      }
+    }),
+  )
+
+  itWait("reports abort without pretending the condition held", () =>
+    Effect.gen(function* () {
+      const controller = new AbortController()
+      const port = yield* closedPort()
+      const pending = run(
+        { until: { kind: "port", port }, intervalMs: 50, timeoutMs: 60_000 },
+        { ...ctx, abort: controller.signal },
+      )
+      yield* Effect.sleep("150 millis")
+      controller.abort()
+      const result = yield* pending
+      expect(result.metadata.aborted).toBe(true)
+      expect(result.metadata.satisfied).toBe(false)
+      expect(result.metadata.timedOut).toBe(false)
+      expect(result.output).toContain("aborted")
+    }),
+  )
+
+  itWait("publishes progress while it waits so it never looks like a hang", () =>
+    Effect.gen(function* () {
+      const seen: number[] = []
+      const port = yield* closedPort()
+      yield* run(
+        { until: { kind: "port", port }, intervalMs: 20, timeoutMs: 400 },
+        {
+          ...ctx,
+          metadata: (input: any) =>
+            Effect.sync(() => {
+              seen.push(input?.metadata?.elapsedMs ?? -1)
+            }),
+        },
+      )
+      expect(seen.length).toBeGreaterThan(1)
+      expect(Math.max(...seen)).toBeGreaterThan(0)
+    }),
+  )
+
+  itWait("tells the model to launch with bash and to wait on a pid", () =>
+    Effect.gen(function* () {
+      const tool = yield* initWait()
+      expect(tool.description).toContain("never starts anything")
+      expect(tool.description).toContain("bash")
+      expect(tool.description).toContain("pid")
+    }),
+  )
+
+  itWait("asks permission under its own name rather than borrowing bash's", () =>
+    Effect.gen(function* () {
+      const asked: string[] = []
+      yield* run(
+        { until: { kind: "file", path: tmp("wait-perm") }, intervalMs: 20, timeoutMs: 50 },
+        {
+          ...ctx,
+          ask: (input: any) =>
+            Effect.sync(() => {
+              asked.push(input.permission)
+            }),
+        },
+      )
+      expect(asked).toEqual(["wait"])
+    }),
+  )
+})
+
+describe("tool.wait parameters", () => {
+  // Schema-only, so it needs no layer or instance 窶・just run the decoder.
+  const decode = (input: unknown) => Effect.runPromise(Schema.decodeUnknownEffect(Parameters)(input))
+
+  test("accepts every condition kind", async () => {
+    expect((await decode({ until: { kind: "process", pid: 1 } })).until).toEqual({ kind: "process", pid: 1 })
+    expect((await decode({ until: { kind: "port", port: 5432 } })).until).toEqual({ kind: "port", port: 5432 })
+  })
+
+  test("refuses a condition kind it does not know", async () => {
+    // `kind` is a closed set, so there is no way to smuggle a command in here.
+    await expect(decode({ until: { kind: "shell", command: "sleep 999" } })).rejects.toBeDefined()
+  })
+
+  test("drops a command field rather than honouring it", async () => {
+    // Effect schemas discard undeclared keys instead of failing, so a model that
+    // tries to sneak a command in gets it silently ignored. The guarantee that
+    // matters is structural: there is no field the tool could read one from.
+    const decoded = await decode({ until: { kind: "port", port: 1 }, command: "npm run dev" })
+    expect(decoded).toEqual({ until: { kind: "port", port: 1 } })
+    expect(Object.keys(decoded).sort()).toEqual(["until"])
+  })
+
+  test("drops a timeout field so the only clock is timeoutMs", async () => {
+    const decoded = await decode({ until: { kind: "port", port: 1 }, timeout: 10 })
+    expect(decoded).toEqual({ until: { kind: "port", port: 1 } })
+  })
+})
