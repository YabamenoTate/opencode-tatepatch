+function HomeSessionDeleteConfirm(props: {
+  session: Session
+  language: ReturnType<typeof useLanguage>
+  onDelete: () => Promise<void>
+}) {
+  const dialog = useDialog()
+  return (
+    <Dialog
+      title={props.language.t("session.delete.title")}
+      action={
+        <ButtonV2
+          variant="ghost"
+          icon="close"
+          class="size-8"
+          aria-label={props.language.t("common.close")}
+          onClick={() => dialog.close()}
+        />
+      }
+    >
+      <div class="flex flex-col gap-6">
+        <p class="text-[13px] leading-5 text-v2-text-text-base">
+          {props.language.t("session.delete.confirm", {
+            name: sessionTitle(props.session.title) || props.session.id,
+          })}
+        </p>
+        <div class="flex items-center justify-end gap-2">
+          <ButtonV2 variant="neutral" onClick={() => dialog.close()}>
+            {props.language.t("common.cancel")}
+          </ButtonV2>
+          <ButtonV2
+            variant="danger"
+            icon="xmark-small"
+            data-action="home-session-delete-confirm"
+            onClick={() => {
+              void props.onDelete()
+              dialog.close()
+            }}
+          >
+            {props.language.t("session.delete.permanent")}
+          </ButtonV2>
+        </div>
+      </div>
+    </Dialog>
+  )
+}
