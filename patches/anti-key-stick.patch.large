+  const toggleTrash = () => setTrashOpen(!trashOpen())
+
+  const restoreSession = async (session: Session) => {
+    const ctx = home.server.focusedContext()
+    if (!ctx) return
+    setTrashBusy(true)
+    try {
+      await ctx.sdk.client.session.update({
+        sessionID: session.id,
+        directory: session.directory,
+        time: { archived: null },
+      })
+      void trashQuery.refetch()
+      void sessionLoad.refetch()
+      showToast({ title: language.t("trash.restore.success") })
+    } catch (cause) {
+      showToast({
+        title: language.t("common.requestFailed"),
+        description: errorMessage(cause, language.t("common.requestFailed")),
+      })
+    } finally {
+      setTrashBusy(false)
+    }
+  }
+
+  const deleteSession = (session: Session) => {
+    const ctx = home.server.focusedContext()
+    if (!ctx) return
+    dialog.show(() => (
+      <HomeSessionDeleteConfirm
+        session={session}
+        language={language}
+        onDelete={async () => {
+          setTrashBusy(true)
+          try {
+            await ctx.sdk.api.session.remove({ sessionID: session.id, directory: session.directory })
+            void trashQuery.refetch()
+            void sessionLoad.refetch()
+            showToast({ title: language.t("trash.delete.success") })
+          } catch (cause) {
+            showToast({
+              title: language.t("common.requestFailed"),
+              description: errorMessage(cause, language.t("common.requestFailed")),
+            })
+          } finally {
+            setTrashBusy(false)
+          }
+        }}
+      />
+    ))
+  }
