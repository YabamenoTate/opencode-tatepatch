diff --git a/packages/opencode/src/cli/cmd/providers.ts b/packages/opencode/src/cli/cmd/providers.ts
index 3775123..0747d67 100644
--- a/packages/opencode/src/cli/cmd/providers.ts
+++ b/packages/opencode/src/cli/cmd/providers.ts
@@ -1,5 +1,6 @@
 import type { Argv } from "yargs"
 import { Auth } from "../../auth"
+import { FSUtil } from "@opencode-ai/core/fs-util"
 import { cmd } from "./cmd"
 import { CliError, effectCmd, fail } from "../effect-cmd"
 import { UI } from "../ui"
@@ -477,12 +478,138 @@ export const ProvidersLoginCommand = effectCmd({
       )
     }
 
-    const key = yield* Prompt.password({
-      message: "Enter your API key",
-      validate: (x) => (x && x.length > 0 ? undefined : "Required"),
-    })
-    const apiKey = yield* promptValue(key)
-    yield* Effect.orDie(authSvc.set(provider, { type: "api", key: apiKey }))
+    const POOL_FILE = path.join(Global.Path.data, "auth-pool.json")
+
+    const maskKey = (key: string) => (key.length <= 8 ? "****" : key.slice(0, 3) + "..." + key.slice(-4))
+
+    const fsys = yield* FSUtil.Service
+
+    const readPool = (): Effect.Effect<Record<string, Array<{ key: string; label?: string }>>> =>
+      fsys.readJson(POOL_FILE).pipe(
+        Effect.map((data) => data as Record<string, Array<{ key: string; label?: string }>>),
+        Effect.orElseSucceed(() => ({}) as Record<string, Array<{ key: string; label?: string }>>),
+      )
+
+    const writePool = (data: Record<string, Array<{ key: string; label?: string }>>) =>
+      fsys.writeJson(POOL_FILE, data, 0o600).pipe(Effect.orDie)
+
+    const getPool = (maybeProvider?: string) =>
+      Effect.gen(function* () {
+        const data = yield* readPool()
+        const targetProvider = maybeProvider ?? provider
+        return { data, list: data[targetProvider] ?? [] }
+      })
+
+    const addToPool = (maybeProvider: string, entry: { key: string; label?: string }) =>
+      Effect.gen(function* () {
+        const { data, list } = yield* getPool(maybeProvider)
+        yield* writePool({ ...data, [maybeProvider]: [...list, entry] })
+      })
+
+    const removeFromPool = (maybeProvider: string, idx: number) =>
+      Effect.gen(function* () {
+        const { data, list } = yield* getPool(maybeProvider)
+        const updated = [...list.slice(0, idx), ...list.slice(idx + 1)]
+        if (updated.length > 0) {
+          yield* writePool({ ...data, [maybeProvider]: updated })
+        } else {
+          const { [maybeProvider]: _, ...rest } = data
+          yield* writePool(rest)
+        }
+      })
+
+    const switchFromPool = (maybeProvider: string, idx: number, newMainKey: string) =>
+      Effect.gen(function* () {
+        const { data, list } = yield* getPool(maybeProvider)
+        const updated = [...list.slice(0, idx), ...list.slice(idx + 1)]
+        if (updated.length > 0) {
+          yield* writePool({ ...data, [maybeProvider]: [...updated, { key: newMainKey }] })
+        } else {
+          yield* writePool({ ...data, [maybeProvider]: [{ key: newMainKey }] })
+        }
+        yield* Effect.orDie(authSvc.set(maybeProvider, { type: "api", key: list[idx].key }))
+      })
+
+    const database = yield* modelsDev.get()
+    accounts: while (true) {
+      const all = yield* Effect.orDie(authSvc.all())
+      const main = all[provider] as Auth.Info | undefined
+      const { list: pool } = yield* getPool()
+
+      if (main) {
+        const keyStr = main.type === "api" ? maskKey(main.key) : main.type
+        yield* Prompt.log.info(`Main account: ${keyStr}`)
+      } else {
+        yield* Prompt.log.info("No current account")
+      }
+      if (pool.length > 0) {
+        yield* Prompt.log.info(`Pool accounts: ${pool.length}`)
+      }
+
+      const options: { label: string; value: string }[] = []
+      options.push({ label: "Add new API key", value: "add" })
+      for (let i = 0; i < pool.length; i++) {
+        options.push({ label: `Use: ${maskKey(pool[i].key)}`, value: `use_${i}` })
+      }
+      if (main) {
+        options.push({ label: "Delete current account", value: "delete_main" })
+      }
+      for (let i = 0; i < pool.length; i++) {
+        options.push({ label: `Delete: ${maskKey(pool[i].key)}`, value: `delete_${i}` })
+      }
+      options.push({ label: "Done", value: "done" })
+
+      const providerName = database?.[provider]?.name ?? provider
+      const action = yield* promptValue(
+        yield* Prompt.select({ message: `Manage accounts for ${providerName}`, options }),
+      )
+
+      if (action === "done") break
+
+      if (action === "add") {
+        const key = yield* promptValue(
+          yield* Prompt.password({
+            message: "Enter your API key",
+            validate: (x) => (x && x.length > 0 ? undefined : "Required"),
+          }),
+        )
+        if (main) {
+          yield* addToPool(provider, { key })
+        } else {
+          yield* Effect.orDie(authSvc.set(provider, { type: "api", key }))
+        }
+        continue
+      }
+
+      if (action.startsWith("use_")) {
+        const idx = Number(action.split("_").pop()!)
+        if (pool[idx]) {
+          if (main && main.type === "api") {
+            yield* switchFromPool(provider, idx, main.key)
+          } else {
+            yield* Effect.orDie(authSvc.set(provider, { type: "api", key: pool[idx].key }))
+            yield* removeFromPool(provider, idx)
+          }
+        }
+        continue
+      }
+
+      if (action === "delete_main") {
+        yield* Effect.orDie(authSvc.remove(provider))
+        const { list: poolAfter } = yield* getPool()
+        if (poolAfter.length > 0) {
+          yield* Effect.orDie(authSvc.set(provider, { type: "api", key: poolAfter[0].key }))
+          yield* removeFromPool(provider, 0)
+        }
+        continue
+      }
+
+      if (action.startsWith("delete_")) {
+        const idx = Number(action.split("_").pop()!)
+        yield* removeFromPool(provider, idx)
+        continue
+      }
+    }
 
     yield* Prompt.outro("Done")
   }),
