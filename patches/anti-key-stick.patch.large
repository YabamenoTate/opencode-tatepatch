+describe("session.retry.decision", () => {
+  test("network failures never rotate and reset the streak", () => {
+    expect(
+      SessionRetry.shouldRotate({ streak: 99, reason: "network", longWait: false }),
+    ).toBe(false)
+  })
+
+  test("first same-key failure waits ~2s without rotating", () => {
+    expect(
+      SessionRetry.shouldRotate({ streak: 1, reason: "rate_limit", longWait: false }),
+    ).toBe(false)
+    expect(
+      SessionRetry.decidedWait({
+        rotate: false,
+        reason: "rate_limit",
+        rotated: { switched: false },
+        retryAfterMs: 7_000,
+      }),
+    ).toBe(SessionRetry.RETRY_SAME_KEY_DELAY_MS)
+  })
+
+  test("second consecutive failure rotates", () => {
+    expect(
+      SessionRetry.shouldRotate({ streak: 2, reason: undefined, longWait: false }),
+    ).toBe(true)
+    expect(
+      SessionRetry.shouldRotate({ streak: 2, reason: "client_error", longWait: false }),
+    ).toBe(true)
+  })
+
+  test("a long quota wait rotates immediately", () => {
+    expect(
+      SessionRetry.shouldRotate({ streak: 1, reason: "account_rate_limit", longWait: true }),
+    ).toBe(true)
+  })
+
+  test("a long non-quota wait still waits for a second failure", () => {
+    expect(
+      SessionRetry.shouldRotate({ streak: 1, reason: undefined, longWait: true }),
+    ).toBe(false)
+  })
+
+  test("a key switch is retried immediately, no forced wait", () => {
+    expect(
+      SessionRetry.decidedWait({
+        rotate: true,
+        reason: "client_error",
+        rotated: { switched: true },
+        retryAfterMs: 60_000,
+      }),
+    ).toBe(0)
+  })
+
+  test("all-cooling waits for the earliest recovery", () => {
+    expect(
+      SessionRetry.decidedWait({
+        rotate: true,
+        reason: "rate_limit",
+        rotated: { switched: false, waitMs: 90_000 },
+        retryAfterMs: 5_000,
+      }),
+    ).toBe(90_000)
+  })
+
+  test("single-account fallback honours the provider hint", () => {
+    expect(
+      SessionRetry.decidedWait({
+        rotate: true,
+        reason: "rate_limit",
+        rotated: { switched: false },
+        retryAfterMs: 30_000,
+      }),
+    ).toBe(30_000)
+  })
+})
+
