+        return out.includes(String(pid))
+      }
+      try {
+        process.kill(pid, 0)
+        return true
+      } catch {
+        return false
+      }
+    })
+
+  const reap = (pid: number) =>
+    Effect.sync(() => {
+      if (process.platform === "win32") Bun.spawnSync(["taskkill", "/PID", String(pid), "/T", "/F"])
+      else {
+        try {
+          process.kill(-pid, "SIGKILL")
+        } catch {
+          try {
+            process.kill(pid, "SIGKILL")
+          } catch {}
+        }
+      }
