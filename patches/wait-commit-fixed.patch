+// Wait applied on the first failure of a key before concluding the key itself
+// is at fault: retry the same key once (~2s), rotate only after a second
+// consecutive failure. A key change is retried immediately instead.
+export const RETRY_SAME_KEY_DELAY_MS = 2_000
+
+// A provider turn that ends without producing any visible reply. Not a hard
+// failure: the message keeps being retried (~2s same key) until a real reply
+// arrives, so a stalled turn never ends the session silently.
+export const EMPTY_REPLY_MESSAGE = "The model returned an empty response"
+
+export const QUOTA_REASONS = new Set([
+  "account_rate_limit",
+  "free_tier_limit",
+  "request_queue_full",
+  "rate_limit",
+])
+
+// True when the failure is the current key's own: quota / rate-limit
+// exhaustion is immediately decisive for a long wait, otherwise the key has to
+// fail twice in a row. Network failures are never the key's fault.
+export function shouldRotate(input: { streak: number; reason?: string; longWait: boolean }): boolean {
+  if (input.reason === "network") return false
+  if (input.reason !== undefined && QUOTA_REASONS.has(input.reason)) {
+    return true
+  }
+  return input.streak >= 2
+}
+
+// Decide how long to sleep before the next attempt:
+//  - no rotation      竊・fixed 2s retry of the same key (network: honour backoff)
+//  - key switched     竊・retry the new key immediately, no forced wait
+//  - pool all cooling 竊・wait for the earliest key recovery
+//  - no pool          竊・honour the provider's hint and keep going
+export function decidedWait(input: {
+  rotate: boolean
+  reason?: string
+  rotated: { switched: boolean; waitMs?: number }
+  retryAfterMs: number
+}): number {
+  if (!input.rotate) {
+    return input.reason === "network" ? input.retryAfterMs : RETRY_SAME_KEY_DELAY_MS
+  }
+  if (input.rotated.switched) return 0
+  if (input.rotated.waitMs !== undefined && input.rotated.waitMs >= 0) {
+    return input.rotated.waitMs
+  }
+  const isQuota = input.reason !== undefined && QUOTA_REASONS.has(input.reason)
+  if (isQuota) {
+    return Math.min(input.retryAfterMs, RETRY_MAX_DELAY_NO_HEADERS)
+  }
+  return input.retryAfterMs
+}
