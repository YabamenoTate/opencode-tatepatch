+  readonly removeByKey: (providerID: string, keyHash: string) => Effect.Effect<boolean, never>
+  readonly switchByKey: (providerID: string, keyHash: string, currentKey?: string) => Effect.Effect<{ found: boolean; key?: string }, never>
+  readonly count: (providerID: string) => Effect.Effect<number, never>
+  readonly resetToMain: (providerID: string) => Effect.Effect<string | undefined, never>
+  readonly rotate: (providerID: string, retryAfterMs?: number, currentKey?: string) => Effect.Effect<RotateResult, never>
+}
+
+export const Service: Context.Service<Interface, Interface> = Context.Service("@opencode/AuthPool")
+
+export function sha256(key: string): string {
+  return crypto.createHash("sha256").update(key).digest("hex")
+}
+
+export interface PublicPoolEntry {
+  key_hash: string
+  key_masked: string
+  label?: string
+}
+
+function maskKey(key: string): string {
+  if (key.length <= 12) return key.slice(0, 4) + "..."
+  return key.slice(0, 8) + "..." + key.slice(-4)
+}
+
+function getEntries(data: PoolData, providerID: string): PoolEntry[] {
+  return Array.isArray(data[providerID]) ? (data[providerID] as PoolEntry[]) : []
+}
+
+function getMain(data: PoolData, providerID: string): string | undefined {
+  const main = data._main as Record<string, string> | undefined
+  return main?.[providerID]
+}
+
+const rawPool = (fsys: AppFileSystem.Service) =>
+  fsys.readJson(POOL_FILE).pipe(Effect.orElseSucceed(() => ({}) as PoolData))
+
+const writePool = (fsys: AppFileSystem.Service, data: PoolData) =>
+  fsys.writeJson(POOL_FILE, data, 0o600).pipe(Effect.orDie)
+
+export const layer = Layer.effect(
+  Service,
+  Effect.gen(function* () {
+    const fsys = yield* AppFileSystem.Service
+
+    const list = Effect.fn("AuthPool.list")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      return getEntries(data, providerID).map((e) => ({
+        key_hash: sha256(e.key),
+        key_masked: maskKey(e.key),
+        label: e.label,
+      }))
+    })
+
+    const add = Effect.fn("AuthPool.add")(function* (providerID: string, entry: PoolEntry) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      arr.push(entry)
+      data[providerID] = arr
+      if (data._tried) {
+        delete (data._tried as Record<string, string[]>)[providerID]
+      }
+      yield* writePool(fsys, data)
+    })
+
+    const removeByKey = Effect.fn("AuthPool.removeByKey")(function* (providerID: string, keyHash: string) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      const idx = arr.findIndex((e) => sha256(e.key) === keyHash)
+      if (idx < 0) return false
+      arr.splice(idx, 1)
+      if (arr.length === 0) {
+        delete data[providerID]
+      } else {
+        data[providerID] = arr
+      }
+      yield* writePool(fsys, data)
+      return true
+    })
+
+    const switchByKey = Effect.fn("AuthPool.switchByKey")(function* (
+      providerID: string,
+      keyHash: string,
+      currentKey?: string,
+    ) {
+      const data = yield* rawPool(fsys)
+      const arr = getEntries(data, providerID)
+      const idx = arr.findIndex((e) => sha256(e.key) === keyHash)
+      if (idx < 0) return { found: false, key: undefined as string | undefined }
+
+      const newKey = arr[idx].key
+
+      if (currentKey && !getMain(data, providerID)) {
+        const main = (data._main as Record<string, string> ?? {})
+        main[providerID] = currentKey
+        data._main = main
+      }
+
+      arr[idx] = { key: currentKey ?? arr[idx].key, label: arr[idx].label }
+      data[providerID] = arr
+      yield* writePool(fsys, data)
+      return { found: true, key: newKey }
+    })
+
+    const count = Effect.fn("AuthPool.count")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      return getEntries(data, providerID).length
+    })
+
+    const resetToMain = Effect.fn("AuthPool.resetToMain")(function* (providerID: string) {
+      const data = yield* rawPool(fsys)
+      const mainKey = getMain(data, providerID)
+      if (!mainKey) return undefined
+
+      const arr = getEntries(data, providerID)
+
+      delete (data._main as Record<string, string>)[providerID]
+      if (Object.keys(data._main as Record<string, string>).length === 0) delete data._main
+      if (data._tried) {
+        delete (data._tried as Record<string, string[]>)[providerID]
+        if (Object.keys(data._tried as Record<string, string[]>).length === 0) delete data._tried
+      }
+      if (data._retryAfter) {
+        delete (data._retryAfter as Record<string, unknown>)[providerID]
+        if (Object.keys(data._retryAfter as Record<string, unknown>).length === 0) delete data._retryAfter
+      }
+
+      yield* writePool(fsys, data)
+      return mainKey
+    })
+
+    const rotate = Effect.fn("AuthPool.rotate")(function* (providerID: string, retryAfterMs?: number, currentKey?: string) {
+      const data = yield* rawPool(fsys)
+      const entries = getEntries(data, providerID)
+      if (entries.length === 0) return { switched: false, exhausted: false } as RotateResult
+
+      const tried = ((data._tried ?? {}) as Record<string, string[]>)[providerID] ?? []
+      const triedHashes = new Set(tried)
+
+      // Permanently mark the current (failed) key as tried so it's skipped
+      if (currentKey) {
+        const currentHash = sha256(currentKey)
+        if (!triedHashes.has(currentHash)) {
+          tried.push(currentHash)
+          triedHashes.add(currentHash)
+        }
+      }
+
+      const untried = entries.filter((e) => !triedHashes.has(sha256(e.key)))
+
+      if (untried.length === 0) {
+        const retryAfter = ((data._retryAfter ?? {}) as Record<string, Record<string, number>>)[providerID] ?? {}
+        let bestKey: string | undefined
+        let bestTime = Infinity
+
+        for (const [hash, recoveryAt] of Object.entries(retryAfter)) {
+          if (recoveryAt < bestTime) {
+            const entry = entries.find((e) => sha256(e.key) === hash)
+            if (entry) {
+              bestKey = entry.key
+              bestTime = recoveryAt
+            }
+          }
+        }
+
+        if (!bestKey) bestKey = getMain(data, providerID)
+
+        return { switched: false, exhausted: true, key: bestKey } as RotateResult
+      }
+
+      const entry = untried[0]
+      const entryHash = sha256(entry.key)
+      tried.push(entryHash)
+      const triedData = (data._tried ?? {}) as Record<string, string[]>
+      triedData[providerID] = tried
+      data._tried = triedData
+
+      if (retryAfterMs !== undefined && retryAfterMs > 0) {
+        const raData = (data._retryAfter ?? {}) as Record<string, Record<string, number>>
+        if (!raData[providerID]) raData[providerID] = {}
+        raData[providerID][entryHash] = Date.now() + retryAfterMs
+        data._retryAfter = raData
+      }
+
+      yield* writePool(fsys, data)
+      return { switched: true, label: entry.label, exhausted: false, key: entry.key } as RotateResult
+    })
+
+    return { list, add, removeByKey, switchByKey, count, resetToMain, rotate }
+  }),
+)
+
+export const defaultLayer = layer.pipe(Layer.provide(AppFileSystem.defaultLayer))
