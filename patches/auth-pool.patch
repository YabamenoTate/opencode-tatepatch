+          if (entry) {
+            bestKey = entry.key
+            bestTime = at
+          }
+        }
+      }
+      if (!bestKey) bestKey = getMain(data, providerID)
+      if (cooldownChanged) yield* writePool(fsys, data)
+      return { switched: false, exhausted: false, key: bestKey } as RotateResult
+    })
+
+    return Service.of({ list, add, removeByKey, switchByKey, count, resetToMain, rotate })
+  }),
+)
+
