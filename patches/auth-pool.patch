+      const now = Date.now()
+      const raData = (data._retryAfter ?? {}) as Record<string, Record<string, number>>
+      const ra = raData[providerID] ?? {}
+      const entryHashes = new Set(entries.map((e) => sha256(e.key)))
+
+      // Tracks whether any cooldown state changed, so the pool file is rewritten.
+      let cooldownChanged = false
+
+      // The only key that actually failed is the current one — record its recovery window
+      if (retryAfterMs !== undefined && retryAfterMs > 0 && currentKey && entryHashes.has(sha256(currentKey))) {
+        ra[sha256(currentKey)] = now + retryAfterMs
+        cooldownChanged = true
+      }
+
+      // Drop stale cooldowns (already recovered, or key removed from the pool),
+      // and migrate away from the old permanent `_tried` map.
+      for (const hash of Object.keys(ra)) {
+        if (!entryHashes.has(hash) || ra[hash] <= now) {
+          delete ra[hash]
+          cooldownChanged = true
+        }
+      }
+      if (data._tried) {
+        delete data._tried
+        cooldownChanged = true
+      }
+      if (Object.keys(ra).length > 0) {
+        raData[providerID] = ra
+        data._retryAfter = raData
+        cooldownChanged = true
+      } else if (raData[providerID] || data._retryAfter) {
